{
  "expo": {
    "name": "Sadhana Connect",
    "slug": "sadhana-connect",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "sadhanaconnect",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sadhanaconnect.app"
    },
    "android": {
      "package": "com.sadhanaconnect.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-sharing",
      "expo-secure-store",
      "expo-font",
      "expo-updates"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "38e0f4dd-9010-467d-acb7-0d2159338b00"
      }
    },
    "owner": "itzabhinav01s-team"
  }
}
