{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@sadhana-connect/domain/*": ["./packages/domain/src/*"],
      "@sadhana-connect/infra-supabase/*": ["./packages/infra-supabase/src/*"],
      "@sadhana-connect/auth": ["./packages/auth/src"],
      "@sadhana-connect/shared": ["./packages/shared/src"],
      "@sadhana-connect/sadhana": ["./packages/sadhana/src"],
      "@sadhana-connect/verse": ["./packages/verse/src"],
      "@sadhana-connect/mentor": ["./packages/mentor/src"],
      "@sadhana-connect/comments": ["./packages/comments/src"],
      "@sadhana-connect/notifications": ["./packages/notifications/src"],
      "@sadhana-connect/announcements": ["./packages/announcements/src"],
      "@sadhana-connect/admin": ["./packages/admin/src"]
    },

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "packages/domain/src",
    "packages/infra-supabase/src",
    "packages/auth/src",
    "packages/shared/src",
    "packages/sadhana/src",
    "packages/verse/src"
  ]
}
